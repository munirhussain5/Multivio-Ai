# GEMINI_API_KEY: Required for Gemini AI API calls and synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional key for ChatGPT / OpenAI provider integration.
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Optional key for Anthropic Claude provider integration.
ANTHROPIC_API_KEY=""

# DEEPSEEK_API_KEY: Optional key for DeepSeek provider integration.
DEEPSEEK_API_KEY=""

# SUPABASE: Supabase backend configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

